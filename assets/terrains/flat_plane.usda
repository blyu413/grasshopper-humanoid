#usda 1.0
(
    defaultPrim = "Ground"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "Ground"
{
    def Plane "CollisionPlane" (
        prepend apiSchemas = ["PhysicsCollisionAPI"]
    )
    {
        uniform token axis = "Z"
        double length = 200
        bool physics:collisionEnabled = 1
        color3f[] primvars:displayColor = [(0.25, 0.25, 0.25)]
        double width = 200
    }
}

