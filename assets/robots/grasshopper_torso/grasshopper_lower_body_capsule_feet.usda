                                                                                            }
                                                                                        }

                                                                                        def Capsule "sole_capsule_1" (
                                                                                            prepend apiSchemas = ["PhysicsCollisionAPI", "MaterialBindingAPI"]
                                                                                        )
                                                                                        {
                                                                                            uniform token axis = "Z"
                                                                                            double height = 0.0639784946237
                                                                                            rel material:binding:physics = </grasshopper_lower_body/sole_contact_material>
                                                                                            custom int mjc:condim = 3
                                                                                            custom float mjc:gap = 0
                                                                                            custom float mjc:margin = 0
                                                                                            custom int mjc:priority = 1
                                                                                            custom float2 mjc:solref = (0.02, 1)
                                                                                            bool physics:collisionEnabled = 1
                                                                                            color3f[] primvars:displayColor = [(0.1, 0.8, 0.5)]
                                                                                            uniform token purpose = "guide"
                                                                                            double radius = 0.01
                                                                                            quatf xformOp:orient = (0.70710677, 0, 0.70710677, 0)
                                                                                            double3 xformOp:translate = (0.099964516129, -0.033, -0.0673)
                                                                                            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient"]
                                                                                        }

