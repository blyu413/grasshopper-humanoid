#usda 1.0
(
    customLayerData = {
        string collisionSource = "grasshopper_lower_body.urdf"
        string generator = "scripts/build_grasshopper_capsule_feet.py"
        string layoutReference = "MJLab Unitree G1: seven longitudinal sole capsules per foot"
    }
    defaultPrim = "grasshopper_lower_body"
    kilogramsPerUnit = 1
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "grasshopper_lower_body" (
    prepend references = @usd/grasshopper_lower_body/grasshopper_lower_body.usda@
    variants = {
        string Physics = "mujoco"
    }
)
{
    def Material "sole_contact_material" (
        prepend apiSchemas = ["PhysicsMaterialAPI"]
    )
    {
        custom int mjc:priority = 1
        float physics:dynamicFriction = 0.6
        float physics:restitution = 0
        float physics:staticFriction = 0.6
    }

    over "Geometry"
    {
        over "base_link"
        {
            over "PELVIS"
            {
                over "R_HIP_P"
                {
                    over "R_HIP_P_rotor"
                    {
                        over "R_HIP_R_BRACKET"
                        {
