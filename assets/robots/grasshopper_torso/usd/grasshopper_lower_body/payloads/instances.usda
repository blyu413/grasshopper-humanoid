#usda 1.0
(
    customLayerData = {
        string creator = "URDF USD Converter v0.3.2"
    }
    endTimeCode = 1000000
    kilogramsPerUnit = 1
    metersPerUnit = 1
    startTimeCode = 0
    upAxis = "Z"
)

def Scope "Instances"
{
    def Xform "pelvis" (
        prepend references = @./geometries.usd@</Geometries/pelvis>
    )
    {
        over "pelvis" (
            apiSchemas = ["MaterialBindingAPI"]
        )
        {
            custom rel material:binding
            prepend rel material:binding = </Instances/pelvis/VisualMaterials/light_gray>
        }

        def Scope "VisualMaterials"
        {
            def Material "light_gray" (
                instanceable = true
                prepend references = @./materials.usda@</Materials/light_gray>
            )
            {
            }
        }
    }

    def Xform "pelvis_1" (
        prepend references = @./geometries.usd@</Geometries/pelvis>
    )
    {
        over "pelvis" (
            apiSchemas = ["PhysicsCollisionAPI", "NewtonCollisionAPI", "PhysicsMeshCollisionAPI", "NewtonMeshCollisionAPI"]
        )
        {
            token physics:approximation = "convexHull"
            token purpose = "guide"
        }
    }

