        def MjcActuator "WAIST_Y_out_actuator"
        {
            uniform double mjc:forceRange:max = 196.52999877929688
            uniform double mjc:forceRange:min = -196.52999877929688
            custom rel mjc:target
            append rel mjc:target = </grasshopper_lower_body/Physics/WAIST_Y_out>
        }

